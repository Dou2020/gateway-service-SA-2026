# Variables de api-gateway/docker-compose.yml. Copiar a .env en esta carpeta (no se versiona) y
# completar; docker compose lo lee solo al correrlo desde aquí. Fuera de Docker:
#   set -a; . ./.env; set +a; mvn spring-boot:run
#
# En producción, los mismos nombres con otros valores (README, "Despliegue a producción").

# Redis es del proyecto infra (revocación de JWT y rate limiting): igual a la de ../.env.
REDIS_PASSWORD=redis_dev

# Secreto HS256 del JWT: el gateway solo verifica, firma identity, así que es igual al de
# ../identity-service/.env. Obligatorio: sin él compose no arranca.
JWT_SECRET=

# Origen del frontend permitido por CORS. En producción: https://$DOMINIO
FRONTEND_URL=http://localhost:3000

# Proxies delante del gateway que agregan X-Forwarded-For: 0 en desarrollo (sin proxy),
# 1 en producción detrás de Caddy. El límite por IP toma la IP real de ahí.
PROXIES_CONFIABLES=0
